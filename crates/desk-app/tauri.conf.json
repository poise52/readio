{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Readio",
  "version": "0.1.0",
  "identifier": "app.readio.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm --prefix ../frontend run generate",
    "frontendDist": "../../frontend/.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "Readio",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      },
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' blob: data: readio-audio: http://readio-audio.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:3000 ws://127.0.0.1:3000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
